    "medium": { "name": "中等", "timeout": 2400, "spawnInterval": 1000, "targetSize": 72, "lifeDeduct": 1 },
    "hard":   { "name": "困难", "timeout": 1800, "spawnInterval": 700,  "targetSize": 64, "lifeDeduct": 1 },
    "insane": { "name": "疯狂", "timeout": 1300, "spawnInterval": 500,  "targetSize": 56, "lifeDeduct": 2 }
  },
  "operations": [
